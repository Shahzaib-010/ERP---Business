# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (dev cluster for local work)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bike_business?retryWrites=true&w=majority

# Long random string, at least 32 characters, used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Business timezone used for display and date filters
APP_TIMEZONE=Asia/Karachi

# Private file storage (Cloudflare R2 or Backblaze B2, S3 API). Optional: without it the
# app runs and the Documents sections say storage is not set up.
# Local: the bike-docs-dev bucket and its own key. Netlify: bike-docs and its own key.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=bike-docs-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
