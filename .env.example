# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (dev cluster for local work)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bike_business?retryWrites=true&w=majority

# Long random string, at least 32 characters, used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Business timezone used for display and date filters
APP_TIMEZONE=Asia/Karachi

# Private file storage (Cloudflare R2 or Backblaze B2, S3-compatible); added in Phase 6
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
